# PostgreSQL (local development defaults only)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5433

# Keycloak (local development defaults only)
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
KEYCLOAK_PORT=8180

# Spring services
DISCOVERY_PORT=8761
API_GATEWAY_PORT=8081
USER_SERVICE_PORT=8101
RESTAURANT_SERVICE_PORT=8102
DELIVERY_SERVICE_PORT=8107

# Expected JWT audience
KEYCLOAK_AUDIENCE=food-delivery-api

# Restaurant document storage
STORAGE_PROVIDER=CLOUDINARY
STORAGE_MAX_FILE_SIZE=10485760

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_BASE_FOLDER=food-delivery/restaurant-documents

S3_BUCKET=
S3_REGION=
S3_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_PATH_STYLE_ACCESS=false
S3_BASE_FOLDER=restaurant-documents

# Delivery location lookup (server-side only; never commit a real key)
DELIVERY_GEOCODING_PROVIDER=google
DELIVERY_GEOCODING_API_KEY=
DELIVERY_GOOGLE_GEOCODING_BASE_URL=https://maps.googleapis.com
DELIVERY_ROUTING_PROVIDER=google
DELIVERY_GOOGLE_ROUTES_BASE_URL=https://routes.googleapis.com
DELIVERY_QUOTE_TTL=5m
DELIVERY_QUOTE_CURRENCY=VND
# Explicit global DEV/MVP delivery policy; no fee is calculated in the frontend.
DELIVERY_BASE_FEE=15000
DELIVERY_INCLUDED_DISTANCE_METERS=3000
DELIVERY_FEE_PER_KM=5000
DELIVERY_MAXIMUM_SERVICE_DISTANCE_METERS=10000
DELIVERY_PRICING_POLICY_VERSION=dev-v1
