# PostgreSQL (local development defaults only)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5433

# Keycloak (local development defaults only)
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
KEYCLOAK_PORT=8180
# Public URL emitted by Keycloak discovery and used as the JWT issuer. It must
# be reachable and identical for Keycloak, Spring resource servers, and apps.
# 10.0.2.2 is only an Android-emulator bridge; it is not automatically a valid
# Docker issuer. Use a common host LAN name/IP when mobile access is required.
KEYCLOAK_PUBLIC_URL=http://localhost:8180

# Spring services
DISCOVERY_PORT=8761
API_GATEWAY_PORT=8081
USER_SERVICE_PORT=8101
NOTIFICATION_SERVICE_PORT=8112
RESTAURANT_SERVICE_PORT=8102
DELIVERY_SERVICE_PORT=8107
PAYMENT_SERVICE_PORT=8109

# Backend-only Keycloak Admin service account (user-service owns Keycloak realm roles)
KEYCLOAK_ADMIN_BASE_URL=http://localhost:8180
KEYCLOAK_ADMIN_REALM=food-delivery
KEYCLOAK_ADMIN_CLIENT_ID=
KEYCLOAK_ADMIN_CLIENT_SECRET=

# Shared internal service API key; never expose this to the browser
INTERNAL_API_KEY=
PAYMENT_MOCK_WEBHOOK_SECRET=change-me-for-local-webhook-tests

# Expo Push Service endpoint (no secret required for this V1 boundary)
EXPO_PUSH_BASE_URL=https://exp.host/--/api/v2

# Restaurant role-sync retry settings
SYSTEM_ROLE_SYNC_ENABLED=true
SYSTEM_ROLE_SYNC_FIXED_DELAY_MS=5000
SYSTEM_ROLE_SYNC_MAX_RETRIES=10
SYSTEM_ROLE_SYNC_INITIAL_RETRY_DELAY_MS=5000
SYSTEM_ROLE_SYNC_MAX_RETRY_DELAY_MS=60000

# Expected JWT audience
KEYCLOAK_AUDIENCE=food-delivery-api

# Restaurant document storage
STORAGE_PROVIDER=CLOUDINARY
STORAGE_MAX_FILE_SIZE=10485760

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_BASE_FOLDER=food-delivery/restaurant-documents
USER_AVATAR_MAX_FILE_SIZE=5242880
USER_AVATAR_CLOUDINARY_BASE_FOLDER=food-delivery/avatars

S3_BUCKET=
S3_REGION=
S3_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_PATH_STYLE_ACCESS=false
S3_BASE_FOLDER=restaurant-documents

# Delivery location lookup (server-side only; never commit a real key)
DELIVERY_VIETMAP_SERVICE_KEY=
DELIVERY_VIETMAP_API_BASE_URL=https://maps.vietmap.vn
DELIVERY_VIETMAP_DISPLAY_TYPE=5
DELIVERY_VIETMAP_ROUTE_VEHICLE=car
VITE_VIETMAP_TILEMAP_KEY=
DELIVERY_QUOTE_TTL=5m
DELIVERY_CHECKOUT_LOCATION_TTL=45m
DELIVERY_QUOTE_CURRENCY=VND
# Explicit global DEV/MVP delivery policy; no fee is calculated in the frontend.
DELIVERY_BASE_FEE=15000
DELIVERY_INCLUDED_DISTANCE_METERS=3000
DELIVERY_FEE_PER_KM=5000
DELIVERY_MAXIMUM_SERVICE_DISTANCE_METERS=10000
DELIVERY_PRICING_POLICY_VERSION=dev-v1
