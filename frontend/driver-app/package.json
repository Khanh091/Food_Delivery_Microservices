  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@react-navigation/bottom-tabs": "^7.18.17",
    "@react-navigation/native": "^7.3.17",
    "@react-navigation/native-stack": "^7.18.9",
    "expo": "~57.0.15",
    "expo-auth-session": "~57.0.8",
    "expo-constants": "~57.0.13",
    "expo-crypto": "~57.0.1",
    "expo-dev-client": "~57.0.14",
    "expo-font": "~57.0.1",
    "expo-linking": "~57.0.7",
    "expo-location": "~57.0.12",
    "expo-notifications": "~57.0.13",
    "expo-secure-store": "~57.0.1",
    "expo-status-bar": "~57.0.1",
    "expo-task-manager": "~57.0.12",
    "expo-web-browser": "~57.0.2",
    "jwt-decode": "^4.0.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.2",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "^0.21.2"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "typescript": "~6.0.3",
    "vitest": "^3.2.7"
  },
  "scripts": {
    "start": "expo start --port 8082",
    "dev": "expo start --dev-client --port 8082",
    "android:reverse": "powershell -NoProfile -ExecutionPolicy Bypass -Command \"Get-Content -Raw -Encoding UTF8 scripts/android-reverse.ps1 | Invoke-Expression\"",
    "dev:android": "npm run android:reverse && npm run dev",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web --port 8082",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "private": true
}
