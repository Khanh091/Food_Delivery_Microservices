EXPO_PUBLIC_API_BASE_URL=http://localhost:8081
# Host defaults work for Expo/web on this machine. For Android, use a common
# LAN/DNS issuer only after KEYCLOAK_PUBLIC_URL and every resource server use
# the same value; 10.0.2.2 alone cannot be the Docker JWT issuer.
EXPO_PUBLIC_KEYCLOAK_BASE_URL=http://localhost:8180
# Backward-compatible alias accepted by the app; prefer KEYCLOAK_BASE_URL.
# EXPO_PUBLIC_KEYCLOAK_URL=http://localhost:8180
EXPO_PUBLIC_KEYCLOAK_REALM=food-delivery
EXPO_PUBLIC_KEYCLOAK_CLIENT_ID=food-delivery-driver-mobile
EXPO_PUBLIC_REDIRECT_SCHEME=fooddeliverydriver
# Keycloak Identity Provider alias. Keep this only after the realm IdP is configured.
EXPO_PUBLIC_KEYCLOAK_GOOGLE_IDP_HINT=google
EXPO_PUBLIC_LOCATION_STALE_AFTER_SECONDS=45
EXPO_PUBLIC_LOCATION_HEARTBEAT_SECONDS=18
# Optional EAS project id for standalone/dev-build Expo push tokens.
EXPO_PUBLIC_EXPO_PROJECT_ID=
# Metro is intentionally separate from the API Gateway.
EXPO_PUBLIC_METRO_PORT=8082
